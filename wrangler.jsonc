{
  "name": "decant",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "decant" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "decant",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true }
}
